<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/transparent">

    <ScrollView
        android:id="@+id/novaSidebarScroll"
        android:layout_width="188dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#EA050505"
        android:clipToPadding="false"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/novaSidebarItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp" />
    </ScrollView>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <View
            android:id="@+id/novaBackdropFade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/nova_library_gradient" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="34dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/npBug"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="34sp" />

        <LinearLayout
            android:id="@+id/infoRow"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_below="@+id/title"
            android:layout_alignStart="@+id/title"
            android:layout_marginTop="6dp"
            android:layout_toStartOf="@+id/clock"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/summary"
            android:layout_width="620dp"
            android:layout_height="112dp"
            android:layout_below="@+id/infoRow"
            android:layout_alignStart="@+id/infoRow"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="4"
            android:textColor="#E6FFFFFF"
            android:textSize="16sp" />

        <FrameLayout
            android:id="@+id/rowsFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/summary"
            android:layout_alignParentStart="true"
            android:layout_marginTop="2dp"
            android:paddingStart="20dp"
            android:paddingEnd="12dp" />

        <org.jellyfin.androidtv.ui.ClockUserView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/title"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="34dp" />

        <org.jellyfin.androidtv.ui.NowPlayingView
            android:id="@+id/npBug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/clock"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/clock" />

    </RelativeLayout>
</LinearLayout>
