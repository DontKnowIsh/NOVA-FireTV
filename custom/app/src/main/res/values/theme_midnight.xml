<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="nova_midnight_accent">#5DADE2</color>
    <color name="nova_midnight_bg">#05070A</color>
    <color name="nova_midnight_panel">#121820</color>

    <style name="Theme.Jellyfin.Midnight" parent="Theme.Jellyfin">
        <item name="android:colorPrimary">@color/nova_midnight_bg</item>
        <item name="android:colorPrimaryDark">@color/nova_midnight_bg</item>
        <item name="android:colorAccent">@color/nova_midnight_accent</item>
        <item name="defaultBackground">@color/nova_midnight_bg</item>
        <item name="defaultSearchColor">@color/nova_midnight_accent</item>
        <item name="progressPrimary">@color/nova_midnight_accent</item>
        <item name="popupMenuBackground">@color/nova_midnight_panel</item>
        <item name="android:colorButtonNormal">@color/nova_midnight_panel</item>
        <item name="buttonDefaultNormalBackground">@color/nova_midnight_panel</item>
        <item name="buttonDefaultHighlightBackground">@color/nova_midnight_accent</item>
        <item name="cardRounding">8dp</item>
        <item name="buttonRounding">8dp</item>
        <item name="inputRounding">8dp</item>
        <item name="popupMenuRounding">8dp</item>
        <item name="overlayDimDimmedLevel">20%</item>
        <item name="controlIconForegroundActive">@color/nova_midnight_accent</item>
        <item name="qrForeground">@color/nova_midnight_accent</item>
    </style>
</resources>
