<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="nova_amber_accent">#FFB300</color>
    <color name="nova_amber_bg">#0C0B08</color>
    <color name="nova_amber_panel">#1B1811</color>

    <style name="Theme.Jellyfin.Amber" parent="Theme.Jellyfin">
        <item name="android:colorPrimary">@color/nova_amber_bg</item>
        <item name="android:colorPrimaryDark">@color/nova_amber_bg</item>
        <item name="android:colorAccent">@color/nova_amber_accent</item>
        <item name="defaultBackground">@color/nova_amber_bg</item>
        <item name="defaultSearchColor">@color/nova_amber_accent</item>
        <item name="progressPrimary">@color/nova_amber_accent</item>
        <item name="popupMenuBackground">@color/nova_amber_panel</item>
        <item name="android:colorButtonNormal">@color/nova_amber_panel</item>
        <item name="buttonDefaultNormalBackground">@color/nova_amber_panel</item>
        <item name="buttonDefaultHighlightBackground">@color/nova_amber_accent</item>
        <item name="cardRounding">6dp</item>
        <item name="buttonRounding">6dp</item>
        <item name="inputRounding">6dp</item>
        <item name="popupMenuRounding">6dp</item>
        <item name="overlayDimDimmedLevel">20%</item>
